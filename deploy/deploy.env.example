# Configuración y secretos del desplegador (se copia a /etc/smarthouse/deploy.env, 0600).
# Los valores de Telegram son opcionales: sin ellos, sh-notify no manda nada
# y el resto del pipeline funciona igual (se completan al hacer el A8).

# --- Telegram (A8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rutas del pipeline (defaults razonables; no hace falta tocarlas) ---
REPO_DIR=/opt/smarthouse
STATE_FILE=/var/lib/smarthouse/state.json
HEALTH_URL=http://127.0.0.1:5000/health
